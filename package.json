{
  "name": "bitpanel",
  "version": "3.0.0",
  "description": "Um painel de indicadores sobre Bitcoin com backend em Node.js (TypeScript) e banco de dados SQLite.",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "build": "tsc && rm -rf dist/views dist/static && cp -r views dist/views && cp -r static dist/static",
    "start:prod": "node dist/server.js",
    "dev": "ts-node server.ts",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "typecheck": "tsc --noEmit",
    "generate-vapid": "node scripts/generate-vapid.js",
    "env:check": "node scripts/sync-env.js --check",
    "env:sync": "node scripts/sync-env.js"
  },
  "keywords": [
    "bitcoin",
    "dashboard",
    "nodejs",
    "typescript",
    "sqlite",
    "DCA"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^8.55.2",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/.claude/"
    ],
    "collectCoverageFrom": [
      "server.ts",
      "!**/node_modules/**"
    ]
  }
}
